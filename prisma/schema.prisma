generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("student")
  phone        String?
  bio          String?
  grade        Int?
  major        String?
  createdAt    DateTime  @default(now())

  notifications Notification[]
  subscriptions Subscription[]
  attempts      Attempt[]
  questions     QandAQuestion[]
  answers       QandAAnswer[]
  tickets       SupportTicket[]
}

model Course {
  id            String  @id @default(cuid())
  title         String
  subject       String
  grade         Int
  major         String?
  summary       String
  level         String
  cover         String
  teacherId     String
  lessons       Json
  conceptIds    String[]
}

model Quiz {
  id          String @id @default(cuid())
  title       String
  courseId    String
  durationMin Int
  questions   Json
}

model Attempt {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  score     Int
  gaps      String[]
  takenAt   DateTime @default(now())
}

model QandAQuestion {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String
  title            String
  body             String
  tags             String[]
  status           String   @default("open")
  acceptedAnswerId String?
  upvotedBy        String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  answers          QandAAnswer[]
}

model QandAAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   QandAQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName   String
  body       String
  upvotedBy  String[]
  createdAt  DateTime @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  grade     Int
  major     String
  startedAt DateTime @default(now())
  expiresAt DateTime
  price     Int
  status    String   @default("active")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PendingPayment {
  id          String   @id @default(cuid())
  userId      String
  userName    String
  plan        String
  months      Int
  price       Int
  status      String   @default("pending_receipt")
  receiptUrl  String?
  receiptName String?
  createdAt   DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  subject   String
  category  String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Json
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String?
  grade     Int?
  major     String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  text      String
  rating    Int
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LiveClass {
  id             String   @id @default(cuid())
  title          String
  courseId       String
  teacherId      String
  scheduledAt    DateTime
  durationMin    Int
  capacity       Int
  enrolled       Int      @default(0)
  status         String   @default("upcoming")
  description    String
  requiredQuizId String?
  notes          String?
  attachments    Json?
}

model LiveChatState {
  liveId         String   @id
  chatMode       String   @default("public")
  chatLocked     Boolean  @default(false)
  kickedFromLive String[]
  bannedFromChat String[]
  updatedAt      DateTime @updatedAt
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  liveId    String
  userId    String
  userName  String
  userRole  String
  text      String
  createdAt DateTime @default(now())
}

model ExamRegistration {
  id           String   @id @default(cuid())
  userId       String
  examId       String
  examType     String
  registeredAt DateTime @default(now())
}

model MockExamAttempt {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  answers   Json
  score     Int
  takenAt   DateTime @default(now())
}

model MockExam {
  id            String   @id @default(cuid())
  title         String
  grade         Int
  major         String
  scheduledAt   DateTime
  durationMin   Int
  questionCount Int
  registered    Int      @default(0)
  capacity      Int
  status        String   @default("upcoming")
  subjects      String[]
  description   String
  fee           Int
  questions     Json?
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  authorId    String
  category    String
  cover       String
  readMinutes Int
  publishedAt DateTime @default(now())
  tags        String[]
  featured    Boolean  @default(false)
}