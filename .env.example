# ─── لازم در همهٔ محیط‌ها ───
# بساز با: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ─── لازم در production ───
# رشتهٔ اتصال Postgres. یکی مجانی از neon.tech بگیر.
DATABASE_URL=

# ─── اختیاری ───
# اتصال مستقیم (بدون pooler). برای migration Prisma روی Neon لازم است.
DIRECT_URL=

# آدرس عمومی اپ. برای redirect مطلق.
NEXT_PUBLIC_APP_URL=http://localhost:3000